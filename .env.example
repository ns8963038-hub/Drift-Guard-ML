# DriftGuard configuration — copy to .env and adjust.
# .env is gitignored; this file documents every key the project reads.

# ── Core ──────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-generate-a-real-one-for-anything-public
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# ── Scheduler (Track A, Phase 8) ──────────────────────────
SCHEDULER_ENABLED=True
# Demo default. The UI shows the configured production value separately;
# nobody watches a dashboard for an hour during a viva.
SIMULATOR_DEFAULT_INTERVAL_SECONDS=30

# ── Email alerts ──────────────────────────────────────────
# Off by default: the console backend prints instead of sending, so a demo
# needs no mail account. Set EMAIL_ENABLED=True and fill in the SMTP block
# to send CRITICAL alerts for real.
EMAIL_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=driftguard@localhost

# ── Uploads ───────────────────────────────────────────────
MAX_ARTIFACT_MB=100
MAX_CSV_MB=50
REFERENCE_SAMPLE_MAX_ROWS=50000
BATCH_FILE_RETENTION_DAYS=30
